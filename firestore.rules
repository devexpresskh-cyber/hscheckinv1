rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Health check endpoint for connection verification
    match /test/{docId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /roles/{roleId} {
      allow read, write: if true;
    }

    match /teachers/{teacherId} {
      allow read, write: if true;
    }

    match /employees/{employeeId} {
      allow read, write: if true;
    }

    match /schedules/{scheduleId} {
      allow read, write: if true;
    }

    match /subject_schedules/{subjectScheduleId} {
      allow read, write: if true;
    }

    match /timetable_periods/{periodId} {
      allow read, write: if true;
    }

    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    match /attendance_corrections/{correctionId} {
      allow read, write: if true;
    }

    match /leave_requests/{leaveId} {
      allow read, write: if true;
    }

    match /holidays/{holidayId} {
      allow read, write: if true;
    }

    match /departments/{departmentId} {
      allow read, write: if true;
    }

    match /locations/{locationId} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /telegram_settings/{id} {
      allow read, write: if true;
    }

    match /telegram_logs/{id} {
      allow read, write: if true;
    }

    match /system_settings/{id} {
      allow read, write: if true;
    }

    match /notifications/{id} {
      allow read, write: if true;
    }
  }
}
